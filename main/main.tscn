[node name="RichTextLabel" type="RichTextLabel" parent="Control/Tutorial/VBoxContainer/MarginContainer" unique_id=1452419700]
layout_mode = 2
theme = ExtResource("29_o8j3b")
bbcode_enabled = true
text = "You went to clean anemones and got lost! You must find your way back home to the coral reef.

Press [color=00f7e3b4][W] [/color]to swim forward slowly
[color=00f7e3b4][S] [/color]will stop you
[color=00f7e3b4][Shift] [/color]and [color=00f7e3b4][Space] [/color]will control your vertical movement
Mash [color=00f7e3b4][A] [/color]and [color=00f7e3b4][D] [/color]to flap your fins and swim faster!
Clean anemones with [color=00f7e3b4][E]

[/color]Watch out for predators! You can hide from them inside anemones which need cleaning from time to time.
They will close when not cleaned for a long time. You can still clean them but from the outside where you're vulnerable."
horizontal_alignment = 1
vertical_alignment = 1

